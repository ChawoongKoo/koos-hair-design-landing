---
import BaseLayout from '../layouts/BaseLayout.astro'
import BookingSidebar from '../components/BookingSidebar.astro'
import BookingServiceStep from '../components/BookingServiceStep.astro'
import BookingDateTimeStep from '../components/BookingDateTimeStep.astro'
import BookingContactStep from '../components/BookingContactStep.astro'
const pageTitle = "Book an Appointment | Koo's Wigs & Design"
---
<BaseLayout pageTitle={pageTitle}>

  <div class="booking-shell">
    <BookingSidebar />
    <main class="panel-right">
      <form class="booking-form" id="booking-form" method="POST" action="/api/booking">
        <BookingServiceStep />
        <BookingDateTimeStep />
        <BookingContactStep />
      </form>
    </main>
  </div>

</BaseLayout>

<style>
  .booking-shell {
    display: grid;
    grid-template-columns: 420px 1fr;
    min-height: calc(100vh - 72px);
  }

  .panel-right {
    background-color: #fafafa;
    padding: 4rem 4.5rem 6rem;
    overflow-y: auto;
  }

  .booking-form {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (max-width: 900px) {
    .booking-shell {
      grid-template-columns: 1fr;
    }

    .panel-right {
      padding: 3rem 2rem 5rem;
    }
  }
</style>
