<div class="step">
    <div class="step-header">
        <span class="step-num">02</span>
        <div>
            <p class="step-label">Date & Time</p>
            <h2 class="step-heading serif-display">When would you like to come in?</h2>
        </div>
    </div>

    <div class="fields-row">
        <div class="field">
            <label class="field-label" for="appt-date">Preferred Date</label>
            <input class="field-input" type="date" id="appt-date" name="date" required/>
        </div>
        <div class="field">
            <label class="field-label" for="appt-time">Preferred Time</label>
            <div class="select-wrap">
                <select class="field-input" id="appt-time" name="time" required disabled>
                    <option value="" disabled selected>Select a date first</option>
                </select>
                <span class="select-arrow">↓</span>
            </div>
            <span class="time-status" id="time-status"></span>
        </div>
    </div>
</div>

<script>
    const SLOT_LABELS: Record<string, string> = {
        '10:00': '10:00 AM',
        '11:00': '11:00 AM',
        '12:00': '12:00 PM',
        '13:00': '1:00 PM',
        '14:00': '2:00 PM',
        '15:00': '3:00 PM',
        '16:00': '4:00 PM',
        '17:00': '5:00 PM',
        '18:00': '6:00 PM',
        '19:00': '7:00 PM',
    };

    const dateInput = document.getElementById('appt-date') as HTMLInputElement;
    const timeSelect = document.getElementById('appt-time') as HTMLSelectElement;
    const timeStatus = document.getElementById('time-status') as HTMLSpanElement;

    dateInput.addEventListener('change', async () => {
        const date = dateInput.value;
        if (!date) return;

        timeSelect.disabled = true;
        timeSelect.innerHTML = '<option value="" disabled selected>Loading...</option>';
        timeStatus.textContent = '';

        try {
            const res = await fetch(`/api/availability?date=${date}`);
            const { available } = await res.json();

            timeSelect.innerHTML = '';

            if (available.length === 0) {
                timeSelect.innerHTML = '<option value="" disabled selected>No times available</option>';
                timeStatus.textContent = 'No availability on this date. Please choose another.';
                timeSelect.disabled = true;
                return;
            }

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.disabled = true;
            placeholder.selected = true;
            placeholder.textContent = 'Select a time';
            timeSelect.appendChild(placeholder);

            available.forEach((slot: string) => {
                const option = document.createElement('option');
                option.value = slot;
                option.textContent = SLOT_LABELS[slot] ?? slot;
                timeSelect.appendChild(option);
            });

            timeSelect.disabled = false;
        } catch {
            timeSelect.innerHTML = '<option value="" disabled selected>Error loading times</option>';
            timeStatus.textContent = 'Could not load availability. Please try again.';
        }
    });
</script>

<style>
